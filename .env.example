# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# Both app.py and runner.py load this automatically on startup.

# --- LLM provider keys (set at least one to enable AI features / the agent) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Optional base-URL overrides for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- LangSmith tracing (optional) --------------------------------------------
# Turn this on to trace every agent ingest/query/lint run. LangChain/deepagents
# read these automatically; runs are named (e.g. "query · ...") and tagged
# "knowledge-library" so they group cleanly in the project.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# Reference the project by stable ID; it is resolved to the current name at
# runtime (rename-proof). LANGSMITH_PROJECT (a name) still works as a fallback.
LANGSMITH_PROJECT_ID=
# LANGSMITH_PROJECT=Knowledge Library
# Reusable RAG eval dataset, referenced by ID (see eval/rag_eval_dataset.json).
LANGSMITH_RAG_DATASET_ID=

# --- App ---------------------------------------------------------------------
# KG_DATA_DIR=data
# PORT=5000

# --- MCP (Model Context Protocol, optional) ----------------------------------
# Connect agents to external MCP servers, and expose BYO-WIKI as one. Opt-in;
# nothing is enabled unless MCP_ENABLED is set. Needs `langchain-mcp-adapters`+`mcp`.
# MCP_ENABLED=supabase,fetch          # comma list of servers to enable
# MCP_ALLOW_WRITES=                    # 1 to allow write tools (still needs per-call approval)
# MCP_CONFIG=mcp.json                  # optional file to add/override servers
# Supabase MCP (hosted, HTTPS — works even where direct Postgres is blocked):
# SUPABASE_ACCESS_TOKEN=               # a Supabase personal access token (sbp_…)
# SUPABASE_PROJECT_REF=                # scope to one project (e.g. bkvbqoodltjpabjmhpku)
# SUPABASE_MCP_READ_ONLY=true          # read-only Postgres user (recommended)
# SUPABASE_MCP_FEATURES=database,docs  # which Supabase tool groups to expose
# GITHUB_API_KEY=                      # GitHub MCP (writable; writes are gated)

# --- Memory layer (optional tuning) ------------------------------------------
# The library's cross-session memory (data/memory.json). Semantic recall needs
# OPENAI_API_KEY (same embeddings as RAG); without it, recall falls back to
# keyword overlap. Defaults are sensible; override only to experiment.
# KG_MEMORY_DEDUP_THRESHOLD=0.92      # cosine >= this reinforces instead of adding
# KG_MEMORY_RECALL_FLOOR=0.20         # min semantic similarity to surface a memory
# KG_MEMORY_RECALL_FLOOR_KEYWORD=0.05 # min keyword overlap (no-embeddings path)

# --- Agent-skill layer (optional tuning) -------------------------------------
# The skill build loop (data/skills.json) grades each drafted skill and gates it
# before a human reviews it. Override the gate thresholds only to experiment.
# SKILL_GATE_ACCEPT=0.70   # rubric mean a skill must reach to pass the gate
# SKILL_GATE_REJECT=0.40   # rubric mean below this is auto-rejected
# SKILL_DET_PASS=0.80      # deterministic check pass-ratio a skill must clear
# SKILL_DEDUP_THRESHOLD=0.93  # cosine >= this revises an existing skill in place
# SKILL_GENERATOR_MODEL=claude-opus-4-8  # Claude model that authors skills + SKILL.md
# SKILL_RUNS_MAX=500       # observability runs kept in data/skill_runs.json

# Export skill runs (build/eval/refine/review) to LangSmith + OTel, in their OWN
# project (separate from any agent-layer LANGSMITH_PROJECT). Needs LANGSMITH_API_KEY.
# SKILL_TRACING=true                        # turn on skill-run export (or rely on LANGSMITH_TRACING)
# LANGSMITH_SKILL_PROJECT=BYO-WIKI Agent Skills
# Optional OTel spans (e.g. to LangSmith's OTLP ingest); needs the OpenTelemetry SDK:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<LANGSMITH_API_KEY>,Langsmith-Project=BYO-WIKI Agent Skills
# OTEL_SERVICE_NAME=byo-wiki-skills

# --- LangGraph orchestration (durable human-in-the-loop + refine cycle) -------
# The skill build can run as a LangGraph StateGraph that PAUSES at the review gate
# and resumes (even in a later process) from a checkpoint. Choose where state lives:
# SKILL_GRAPH_CHECKPOINT=sqlite            # sqlite (default) | postgres | memory
# SKILL_GRAPH_DB=data/skill_graph.sqlite   # sqlite file path
# SKILL_GRAPH_MAX_REVISIONS=4               # max revise cycles before giving up
#
# Postgres checkpoints (durable, shared, cross-machine resume). Needs the optional
# psycopg/langgraph-checkpoint-postgres deps; falls back to SQLite if unavailable.
# Prepared statements are disabled + autocommit on, so the Supabase transaction
# pooler (port 6543) works; a direct/session connection (5432) works too.
# SKILL_GRAPH_DB_URL=                       # postgres URL (falls back to SUPABASE_DB_URL)
# SKILL_GRAPH_PG_SCHEMA=skill_graph         # dedicated schema for checkpoint tables
# SKILL_GRAPH_PG_POOL=4                     # max pooled connections
# --- Claude Code subprocess backend (SKILL_BACKEND=claude_code) ---------------
# Generate skills by invoking the Claude Code CLI as a tool-using subprocess agent.
# Requires the `claude` CLI installed (npm i -g @anthropic-ai/claude-code) + auth.
# SKILL_BACKEND=pipeline           # default generator: pipeline | claude_code
# CLAUDE_CODE_BIN=claude           # path to the Claude Code CLI
# CLAUDE_CODE_MODEL=claude-opus-4-8
# CLAUDE_CODE_TIMEOUT=240          # subprocess timeout (seconds)
# CLAUDE_CODE_ALLOWED_TOOLS=Read,Write,Edit,Glob
# CLAUDE_CODE_PERMISSION_MODE=acceptEdits
# CLAUDE_CODE_ALLOWED_TOOLS_FLAG=--allowed-tools   # set to --allowedTools on older CLIs
