# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# Both app.py and runner.py load this automatically on startup.

# --- LLM provider keys (set at least one to enable AI features / the agent) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Optional base-URL overrides for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- LangSmith tracing (optional) --------------------------------------------
# Turn this on to trace every agent ingest/query/lint run. LangChain/deepagents
# read these automatically; runs are named (e.g. "query · ...") and tagged
# "knowledge-library" so they group cleanly in the project.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# Reference the project by stable ID; it is resolved to the current name at
# runtime (rename-proof). LANGSMITH_PROJECT (a name) still works as a fallback.
LANGSMITH_PROJECT_ID=
# LANGSMITH_PROJECT=Knowledge Library
# Reusable RAG eval dataset, referenced by ID (see eval/rag_eval_dataset.json).
LANGSMITH_RAG_DATASET_ID=

# --- App ---------------------------------------------------------------------
# KG_DATA_DIR=data
# PORT=5000
